<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY overlay: adds the notification-inject receiver. Never present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugInjectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="net.farcaster.pixelbridge.INJECT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
